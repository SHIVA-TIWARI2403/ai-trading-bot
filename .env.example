# ==========================================
# TRADING BOT CONFIGURATION & SECRETS
# Rename this file to .env on your local machine.
# DO NOT COMMIT YOUR REAL .env TO GITHUB!
# ==========================================

# Mode: 'PAPER' for virtual money simulation, 'LIVE' for broker execution
TRADING_MODE=PAPER

# Initial Virtual Capital (INR)
INITIAL_CAPITAL=500.0

# Maximum risk per single trade (percentage of capital)
RISK_PER_TRADE_PERCENT=2.0

# Max daily loss limit in Rupees before stopping the bot for the day
MAX_DAILY_LOSS=20.0

# Maximum allowed trades per day (to prevent over-trading)
MAX_TRADES_PER_DAY=3

# Target Risk to Reward Ratio (e.g. 2.0 means 1:2 RRR)
RISK_REWARD_RATIO=2.0

# ==========================================
# BROKER API CREDENTIALS (FOR FUTURE LIVE TRADING)
# ==========================================
# Leave blank for Paper Trading mode
BROKER_CHOICE=NONE
BROKER_API_KEY=your_api_key_here
BROKER_API_SECRET=your_api_secret_here
BROKER_CLIENT_CODE=your_client_code_here
BROKER_PIN=your_totp_or_pin_here
